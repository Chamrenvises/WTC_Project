rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "chamrenvises6@gmail.com";
    }

    function isStockDecreaseOnly() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stock"])
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isStockDecreaseOnly();
    }

    match /catalogOptions/{optionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
